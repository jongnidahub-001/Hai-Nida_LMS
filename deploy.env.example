# คัดลอกเป็น deploy.env แล้วแก้ค่า scripts/bootstrap-gcp.sh จะอ่านไฟล์นี้ให้เอง
# deploy.env ไม่ถูก commit ค่าที่ส่งทาง command line มีผลก่อนค่าในไฟล์นี้

PROJECT_ID=
REGION=asia-southeast1
ZONE=asia-southeast1-b
VM_NAME=hai-nida
MACHINE_TYPE=e2-medium
DISK_SIZE=30GB
NETWORK=default

# เว้นว่าง = ใช้ IP และ HTTP, ใส่โดเมน = HTTPS อัตโนมัติ (ต้องชี้ DNS มาที่ static IP)
DOMAIN=

# เว้นว่าง = สร้าง Gemini API key ใหม่ใน project
GEMINI_KEY=

# เว้นว่าง = admin@<DOMAIN หรือ example.com>
ADMIN_EMAIL=

# เว้นว่าง = ใช้ git remote origin ของ clone นี้
REPO_URL=
BRANCH=release
POLL_INTERVAL=5min
