# แม่แบบของ /opt/hai-nida/.env.prod บน VM
# ระบบที่ติดตั้งด้วย scripts/bootstrap-gcp.sh จะสร้างไฟล์นี้จาก Secret Manager ให้เอง ไม่ต้องแก้ด้วยมือ

GOOGLE_API_KEY=
SECRET_KEY=

# ใช้สร้าง admin คนแรกเท่านั้น ถ้า ADMIN_PASSWORD ว่างระบบจะไม่สร้าง admin
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# เว้นว่างได้ เพราะ frontend กับ backend อยู่ origin เดียวกันหลัง Caddy
CORS_ORIGINS=

# ใส่ชื่อโดเมนเมื่อต้องการ HTTPS ถ้าใช้ IP ให้คงเป็นคอมเมนต์ไว้ (ห้ามตั้งเป็นค่าว่าง)
# SITE_ADDRESS=lms.example.com
