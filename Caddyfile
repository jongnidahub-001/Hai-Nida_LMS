# SITE_ADDRESS อ่านจาก .env.prod ถ้าไม่ตั้งจะรับ HTTP ที่ port 80 ผ่าน static IP
# ถ้าตั้งเป็นชื่อโดเมน (เช่น lms.example.com) Caddy จะออกใบรับรอง HTTPS ให้อัตโนมัติ
# ห้ามใส่ SITE_ADDRESS= แบบค่าว่าง Caddy จะอ่านไฟล์ไม่ผ่าน ถ้าไม่ใช้โดเมนให้ลบบรรทัดนั้นออก
{$SITE_ADDRESS::80} {
    handle /api/* {
        reverse_proxy backend:5000
    }

    handle /docs {
        reverse_proxy backend:5000
    }

    handle /openapi.json {
        reverse_proxy backend:5000
    }

    handle /redoc {
        reverse_proxy backend:5000
    }

    handle {
        reverse_proxy frontend:80
    }

    log {
        output file /data/access.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}
